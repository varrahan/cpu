read_verilog -D SYNTHESIS rtl/photonic/photonic_memories.v
read_verilog rtl/fetch/rvc_decompressor.v
read_verilog rtl/fetch/fetch_stage.v
read_verilog rtl/decode/decoder.v
read_verilog rtl/decode/regfile.v
read_verilog rtl/decode/fp_regfile.v
read_verilog rtl/decode/csr_file.v
read_verilog rtl/execute/alu.v
read_verilog rtl/execute/branch_unit.v
read_verilog rtl/execute/forwarding_unit.v
read_verilog rtl/execute/hazard_unit.v
read_verilog -D SYNTHESIS rtl/execute/muldiv_unit.v
read_verilog -sv -D SYNTHESIS rtl/execute/fpu_wrapper.sv
read_verilog rtl/memory/memory_stage.v
read_verilog rtl/memory/pmp_checker.v
read_verilog rtl/memory/sv32_mmu.v
read_verilog rtl/memory/memory_arbiter4.v
read_verilog rtl/memory/icache.v
read_verilog rtl/memory/dcache.v
read_verilog rtl/debug/debug_control.v
read_verilog rtl/top/top.v
read_verilog -lib rtl/photonic/photonic_cells.v

synth -top top -flatten -noabc
dfflibmap -prepare -liberty photonic/photonic.lib
opt_clean
abc -lut 3 -D 40
techmap -map photonic/lut_map.v
dfflibmap -map-only -liberty photonic/photonic.lib
clean -purge
check
stat
write_json build/photonic/top_mapped.json
write_verilog -noattr -noexpr build/photonic/top_mapped.v
