read_verilog -D SYNTHESIS rtl/photonic/photonic_memories.v
read_verilog rtl/fetch/rvc_decompressor.v rtl/fetch/fetch_stage.v
read_verilog rtl/decode/decoder.v rtl/decode/regfile.v rtl/decode/fp_regfile.v
read_verilog rtl/decode/csr_file.v
read_verilog rtl/execute/alu.v rtl/execute/branch_unit.v
read_verilog rtl/execute/forwarding_unit.v rtl/execute/hazard_unit.v
read_verilog -D SYNTHESIS rtl/execute/muldiv_unit.v
read_verilog -sv -D SYNTHESIS rtl/execute/fpu_wrapper.sv
read_verilog rtl/memory/memory_stage.v rtl/memory/pmp_checker.v
read_verilog rtl/memory/sv32_mmu.v rtl/memory/memory_arbiter4.v
read_verilog rtl/memory/icache.v rtl/memory/dcache.v
read_verilog rtl/debug/debug_control.v rtl/top/top.v
hierarchy -top top
proc
opt_clean
write_json build/cdc/top.json

design -reset
read_verilog -sv rtl/debug/riscv_debug_transport.sv
hierarchy -top riscv_debug_transport
proc
opt_clean
write_json build/cdc/debug.json
