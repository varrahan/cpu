[options]
mode bmc
depth 3

[engines]
smtbmc z3

[script]
read -formal -sv -D RISCV_FORMAL -D FORMAL_COMMIT formal_models.sv rvc_decompressor.v fetch_stage.v decoder.v regfile.v fp_regfile.v csr_file.v alu.v branch_unit.v forwarding_unit.v hazard_unit.v memory_stage.v pmp_checker.v sv32_mmu.v memory_arbiter4.v icache.v dcache.v debug_control.v top.v top_harness.sv
prep -top top_harness

[files]
formal/formal_models.sv
rtl/fetch/rvc_decompressor.v
rtl/fetch/fetch_stage.v
rtl/decode/decoder.v
rtl/decode/regfile.v
rtl/decode/fp_regfile.v
rtl/decode/csr_file.v
rtl/execute/alu.v
rtl/execute/branch_unit.v
rtl/execute/forwarding_unit.v
rtl/execute/hazard_unit.v
rtl/memory/memory_stage.v
rtl/memory/pmp_checker.v
rtl/memory/sv32_mmu.v
rtl/memory/memory_arbiter4.v
rtl/memory/icache.v
rtl/memory/dcache.v
rtl/debug/debug_control.v
rtl/top/top.v
formal/top_harness.sv
