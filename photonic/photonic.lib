library(photonic) {
  delay_model : table_lookup;
  time_unit : "1ps";
  capacitive_load_unit (1, ff);

  cell(P_TBIN_DFF) {
    area : 1;
    ff(IQ, IQN) {
      clocked_on : "CLK";
      next_state : "D";
    }
    pin(D)   { direction : input; }
    pin(CLK) { direction : input; clock : true; }
    pin(Q)   { direction : output; function : "IQ"; }
  }

  cell(P_TBIN_DFFR) {
    area : 1;
    ff(IQ, IQN) {
      clocked_on : "CLK";
      next_state : "D";
      clear : "RESET";
    }
    pin(D)     { direction : input; }
    pin(RESET) { direction : input; }
    pin(CLK)   { direction : input; clock : true; }
    pin(Q)     { direction : output; function : "IQ"; }
  }
}
